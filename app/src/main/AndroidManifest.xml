<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>

    <!-- Needed on Android 11+ so the WhatsApp / dialer / mail intents in
         SupportActivity can resolve a handler. Without <queries> the
         package visibility rules make them silently fail. -->
    <queries>
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

    <application
        android:name=".TradingApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="TradeX"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.TradingApp"
        android:usesCleartextTraffic="true">

        <activity android:name=".ui.splash.SplashActivity" android:exported="true"
            android:theme="@style/Theme.TradingApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.LoginActivity" android:exported="false"
            android:theme="@style/Theme.TradingApp.Login"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.auth.SignupActivity"     android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.auth.OtpVerifyActivity"  android:exported="false"/>
        <activity android:name=".ui.main.MainActivity"       android:exported="false"/>
        <activity android:name=".ui.chart.ChartActivity"     android:exported="false"/>
        <activity android:name=".ui.order.OrderActivity"     android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.profile.ProfileActivity" android:exported="false"/>
        <activity android:name=".ui.profile.AccountInfoActivity" android:exported="false"/>
        <activity android:name=".ui.search.SearchActivity"   android:exported="false"/>
        <activity android:name=".ui.optionchain.OptionChainActivity" android:exported="false"/>
        <activity android:name=".ui.wallet.AddFundsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.wallet.PaymentMethodActivity" android:exported="false"
            android:theme="@style/Theme.TradingApp"/>
        <activity android:name=".ui.kyc.KycUploadActivity"  android:exported="false"/>
        <activity android:name=".ui.kyc.KycPreviewActivity" android:exported="false"/>

        <!-- ══ Added by the features 1–8 patch ══════════════════════ -->

        <!-- #3 account under review -->
        <activity android:name=".ui.profile.AccountStatusActivity"
            android:exported="false"/>

        <!-- #4 all orders -->
        <activity android:name=".ui.orders.MyOrdersActivity"
            android:exported="false"/>

        <!-- #5 customer support -->
        <activity android:name=".ui.support.SupportActivity"
            android:exported="false"/>

        <!-- #6 refer & earn -->
        <activity android:name=".ui.refer.ReferEarnActivity"
            android:exported="false"/>

        <!-- #7 withdrawals -->
        <activity android:name=".ui.wallet.WithdrawActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.wallet.AddPayoutMethodActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <!-- #8 in-app WebView for About / Charges -->
        <activity android:name=".ui.web.WebViewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

    </application>
</manifest>
