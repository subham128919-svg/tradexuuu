<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <application
        android:name=".TradingApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="TradeX"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.TradingApp"
        android:usesCleartextTraffic="true">

        <activity android:name=".ui.splash.SplashActivity" android:exported="true"
            android:theme="@style/Theme.TradingApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.LoginActivity"      android:exported="false"/>
        <activity android:name=".ui.auth.SignupActivity"     android:exported="false"/>
        <activity android:name=".ui.main.MainActivity"       android:exported="false"/>
        <activity android:name=".ui.chart.ChartActivity"     android:exported="false"/>
        <activity android:name=".ui.order.OrderActivity"     android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.profile.ProfileActivity" android:exported="false"/>
        <activity android:name=".ui.search.SearchActivity"   android:exported="false"/>
        <activity android:name=".ui.optionchain.OptionChainActivity" android:exported="false"/>
        <activity android:name=".ui.wallet.AddFundsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <!-- No manual declaration needed for com.razorpay.CheckoutActivity —
             the Razorpay SDK's own AAR manifest already declares it with
             the correct exported/theme values, and Gradle's manifest
             merger pulls it in automatically. Declaring it here too
             caused a merge conflict (mismatched exported/theme values). -->

    </application>
</manifest>
