<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base dark theme. Add to AndroidManifest: android:theme="@style/Theme.TradingApp" -->
    <style name="Theme.TradingApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_surface</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_nav</item>
        <item name="colorPrimary">@color/accent</item>
    </style>

    <style name="Theme.TradingApp.BottomSheet" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Text helpers -->
    <style name="TextSectionTitle">
        <item name="android:textSize">15.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/t100</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextMono">
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>