<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TradingApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorOnPrimary">@color/t100</item>
        <item name="android:windowBackground">@color/bg_surface</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:textColorPrimary">@color/t100</item>
        <item name="android:textColorSecondary">@color/t600</item>
        <item name="android:textColorHint">@color/t700</item>
        <item name="android:editTextColor">@color/t100</item>
        <item name="colorOnSurface">@color/t100</item>
        <item name="colorOnBackground">@color/t100</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="android:colorBackground">@color/bg_surface</item>
    </style>

    <style name="OtpBoxStyle">
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1A1A2E</item>
    </style>

    <style name="AccountInfoRow">
        <item name="android:orientation">horizontal</item>
    </style>
</resources>