<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="1dp"
    android:layout_marginBottom="1dp"
    android:background="@drawable/bg_card"
    android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="12dp" android:paddingBottom="12dp">

    <!-- Row 1: Logo | Symbol/Qty | LTP | Exit button -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <!-- Logo circle -->
        <TextView android:id="@+id/tvLogo"
            android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:textSize="12sp" android:textStyle="bold"
            android:textColor="@color/t100" android:background="@drawable/bg_logo"
            android:layout_marginEnd="12dp"/>

        <!-- Symbol + qty/avg -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvSymbol"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/t100"/>
            <TextView android:id="@+id/tvQtyAvg"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11.5sp" android:textColor="@color/bg_surface"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- LTP + P&L -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end" android:layout_marginEnd="10dp">
            <TextView android:id="@+id/tvLtp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/t100"
                android:fontFamily="@font/jetbrains_mono"/>
            <TextView android:id="@+id/tvPnl"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11.5sp" android:fontFamily="@font/jetbrains_mono"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- EXIT button -->
        <TextView android:id="@+id/btnExit"
            android:layout_width="wrap_content" android:layout_height="32dp"
            android:text="Exit" android:textSize="12sp" android:textStyle="bold"
            android:textColor="@color/negative"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:gravity="center"
            android:background="@drawable/bg_app_logo"/>
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="0.5dp"
        android:background="@color/div06" android:layout_marginTop="12dp"
        android:layout_marginStart="-16dp" android:layout_marginEnd="-16dp"/>

</LinearLayout>
