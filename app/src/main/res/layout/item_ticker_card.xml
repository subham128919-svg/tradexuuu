<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_stock_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_ticker_badge"
        android:gravity="center"
        android:text="BA"
        android:textColor="#C7CDD6"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSymbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="BAJFINANCE"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Rs.1105.00"
        android:textColor="#F5F7FA"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvChangePct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="+2.50%"
        android:textColor="#2ECC71"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
