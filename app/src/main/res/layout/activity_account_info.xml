<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Account Info"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- BO Demat Card (shown only for verified) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutDemat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1A1A2E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BO DEMAT NUMBER"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tvDematNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Depository: CDSL  •  TradeX Securities"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Personal Details Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERSONAL DETAILS"
                        android:textColor="#777777"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <!-- Name -->
                    <LinearLayout style="@style/AccountInfoRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">
                        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                            android:text="Name" android:textColor="#999999" android:textSize="13sp" />
                        <TextView android:id="@+id/tvName" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:textColor="#1A1A2E" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Email -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">
                        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                            android:text="Email" android:textColor="#999999" android:textSize="13sp" />
                        <TextView android:id="@+id/tvEmail" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:textColor="#1A1A2E" android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Phone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">
                        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                            android:text="Phone" android:textColor="#999999" android:textSize="13sp" />
                        <TextView android:id="@+id/tvPhone" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:textColor="#1A1A2E" android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Joined -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">
                        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                            android:text="Joined" android:textColor="#999999" android:textSize="13sp" />
                        <TextView android:id="@+id/tvJoinedAt" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:textColor="#1A1A2E" android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- KYC Details Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KYC DETAILS"
                        android:textColor="#777777"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">
                        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                            android:text="Status" android:textColor="#999999" android:textSize="13sp" />
                        <TextView android:id="@+id/tvKycStatus" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">
                        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                            android:text="PAN" android:textColor="#999999" android:textSize="13sp" />
                        <TextView android:id="@+id/tvPanNumber" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:textColor="#1A1A2E" android:textSize="14sp" android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">
                        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                            android:text="Aadhaar" android:textColor="#999999" android:textSize="13sp" />
                        <TextView android:id="@+id/tvAadhaarNumber" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:textColor="#1A1A2E" android:textSize="14sp" android:fontFamily="monospace" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
