<?xml version="1.0" encoding="utf-8"?>
<!-- Tool/shortcut grid item (4-per-row). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal">

    <FrameLayout android:layout_width="46dp" android:layout_height="46dp">
        <TextView android:id="@+id/tvLogo"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center"
            android:text="MT" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/t_tool"
            android:background="@drawable/bg_tool" />

        <!-- Notification badge: GONE when unused -->
        <TextView android:id="@+id/tvBadge"
            android:layout_width="wrap_content" android:layout_height="16dp"
            android:minWidth="16dp" android:gravity="center"
            android:text="6" android:textSize="9.5sp" android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_badge"
            android:paddingStart="4dp" android:paddingEnd="4dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-5dp" android:layout_marginEnd="-5dp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView android:id="@+id/tvLabel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="MTF" android:textSize="11sp" android:textColor="@color/t_tool"
        android:gravity="center" android:layout_marginTop="7dp" />
</LinearLayout>
