<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF7F2"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- ============================================================ -->
    <!-- GUIDELINE — header takes top 22% of screen                    -->
    <!-- ============================================================ -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="695dp" />

    <!-- ============================================================ -->
    <!-- HEADER ART — fills top 22%                                    -->
    <!-- ============================================================ -->

    <FrameLayout
        android:id="@+id/headerArtContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/guideHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/txv_hero"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/brandSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Back arrow -->
            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                android:tint="#FFFFFF"
                android:contentDescription="Back"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/logoBox"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:contentDescription="TradeX logo"
                android:scaleType="fitCenter"
                android:src="@drawable/app_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="TradeX"
                        android:textColor="#122C22"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/brandX"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|top"
                        android:fontFamily="sans-serif"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="X"
                        android:textColor="#118A60"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/brandTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Start your investing journey"
                    android:textColor="#557367"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>


    <!-- ============================================================ -->
    <!-- REGISTRATION CARD — fills from header bottom to screen bottom  -->
    <!-- ============================================================ -->

    <androidx.cardview.widget.CardView
        android:id="@+id/signupCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="-14dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:layout_constraintTop_toBottomOf="@id/guideHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Inner scroll ONLY if content exceeds card on tiny phones -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/signupCardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="22dp"
                android:paddingBottom="16dp">

                <!-- Accent bar -->
                <View
                    android:layout_width="32dp"
                    android:layout_height="4dp"
                    android:background="@drawable/txv_accent" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:includeFontPadding="false"
                    android:text="Create account"
                    android:textColor="#122C22"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Open your TradeX account and start trading."
                    android:textColor="#65796E"
                    android:textSize="12.5sp" />


                <!-- ================================================= -->
                <!-- FULL NAME                                          -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/labelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="FULL NAME"
                    android:textColor="#496458"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.09" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:minHeight="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/txv_input"
                    android:addStatesFromChildren="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="50dp"
                        android:background="@android:color/transparent"
                        android:hint="Enter your full name"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#122C22"
                        android:textColorHint="#8B9C92"
                        android:textSize="14.5sp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:imeOptions="actionNext" />
                </LinearLayout>


                <!-- ================================================= -->
                <!-- EMAIL                                               -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/labelEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="EMAIL ADDRESS"
                    android:textColor="#496458"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.09" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:minHeight="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/txv_input"
                    android:addStatesFromChildren="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="50dp"
                        android:background="@android:color/transparent"
                        android:hint="Enter your email"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#122C22"
                        android:textColorHint="#8B9C92"
                        android:textSize="14.5sp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:imeOptions="actionNext" />
                </LinearLayout>


                <!-- ================================================= -->
                <!-- PHONE — with flag + code like login                 -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/labelPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="MOBILE NUMBER"
                    android:textColor="#496458"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.09" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:minHeight="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/txv_input"
                    android:addStatesFromChildren="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="17dp"
                        android:src="@drawable/txv_flag_india"
                        android:contentDescription="India" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+91"
                        android:textColor="#254336"
                        android:textSize="14sp"
                        android:layout_marginStart="7dp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="#DBE7DF" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="50dp"
                        android:background="@android:color/transparent"
                        android:hint="Your mobile number"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#122C22"
                        android:textColorHint="#8B9C92"
                        android:textSize="14.5sp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:imeOptions="actionNext" />
                </LinearLayout>


                <!-- ================================================= -->
                <!-- PASSWORD                                            -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/labelPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="PASSWORD"
                    android:textColor="#496458"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.09" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:minHeight="50dp"
                    android:background="@drawable/txv_input"
                    app:boxBackgroundMode="none"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#496458">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:background="@android:color/transparent"
                        android:hint="Minimum 6 characters"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:paddingStart="14dp"
                        android:paddingEnd="52dp"
                        android:textColor="#122C22"
                        android:textColorHint="#8B9C92"
                        android:textSize="14.5sp"
                        android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Use at least 6 characters."
                    android:textColor="#8B9C92"
                    android:textSize="10sp"
                    android:includeFontPadding="false" />


                <!-- Error -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:textColor="#B3261E"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:accessibilityLiveRegion="polite"
                    tools:text="All fields are required" />


                <!-- ================================================= -->
                <!-- SPACER — pushes button + footer to bottom of card   -->
                <!-- ================================================= -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />


                <!-- ================================================= -->
                <!-- CREATE ACCOUNT BUTTON                               -->
                <!-- ================================================= -->

                <Button
                    android:id="@+id/btnSignup"
                    style="@style/Widget.AppCompat.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/txv_button"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:minHeight="52dp"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:text="Create Account"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:drawableEnd="@drawable/txv_arrow_white"
                    android:drawablePadding="8dp" />


                <!-- ================================================= -->
                <!-- TRUST ROW                                           -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/securityRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/txv_trust"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/txv_shield" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Secure\nsign up"
                            android:textColor="#527363"
                            android:textSize="8.5sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="#DCECE2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/txv_lock" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="OTP\nverified"
                            android:textColor="#527363"
                            android:textSize="8.5sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="#DCECE2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/txv_bars" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Your data\nis safe"
                            android:textColor="#527363"
                            android:textSize="8.5sp" />
                    </LinearLayout>
                </LinearLayout>


                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#EAF0EC" />

                <!-- Already have account -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Already on TradeX?"
                        android:textColor="#65796E"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Sign in"
                        android:textColor="#087E59"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:minHeight="44dp"
                        android:gravity="center"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:drawableEnd="@drawable/txv_arrow"
                        android:drawablePadding="4dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:contentDescription="Sign In"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>