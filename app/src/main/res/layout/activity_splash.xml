<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <FrameLayout android:id="@+id/logoContainer"
        android:layout_width="72dp" android:layout_height="72dp"
        android:background="@drawable/bg_app_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvAppName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias=".42">
        <View android:layout_width="26dp" android:layout_height="26dp"
            android:layout_gravity="center" android:background="@color/bg_surface" android:rotation="45"/>
    </FrameLayout>

    <TextView android:id="@+id/tvAppName"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TradeX"
        android:textSize="32sp" android:textStyle="bold" android:textColor="@color/t100"
        android:letterSpacing="-0.02" android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/logoContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView android:id="@+id/tvTagline"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Invest. Track. Grow."
        android:textSize="14sp" android:textColor="@color/t700"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:indeterminateTint="@color/accent"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
