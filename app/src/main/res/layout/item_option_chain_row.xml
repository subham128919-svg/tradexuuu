<?xml version="1.0" encoding="utf-8"?>
<!--
  item_option_chain_row.xml — REPLACE. Item 1.

  CHANGED: the row is wrapped in a vertical container so an ATM marker
  band can sit above the strike nearest to spot. Everything inside
  rowContent is identical to your existing row, so every view ID the
  adapter already uses still resolves. The band is GONE on every row
  except the ATM one, so it costs one extra view per row and nothing else.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ATM marker: "price is here" -->
    <LinearLayout
        android:id="@+id/atmBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="6dp" android:paddingBottom="6dp">

        <View android:layout_width="0dp" android:layout_height="1dp"
            android:layout_weight="1" android:background="#6D5EF8" />

        <TextView
            android:id="@+id/tvAtmLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:background="@drawable/bg_atm_pill"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="SPOT"
            android:textColor="#FFFFFF" android:textSize="10.5sp"
            android:textStyle="bold" android:fontFamily="monospace" />

        <View android:layout_width="0dp" android:layout_height="1dp"
            android:layout_weight="1" android:background="#6D5EF8" />
    </LinearLayout>

    <!-- The row itself (unchanged) -->
    <LinearLayout
        android:id="@+id/rowContent"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingTop="10dp" android:paddingBottom="10dp"
        android:paddingStart="10dp" android:paddingEnd="10dp">

        <!-- CALL side -->
        <LinearLayout
            android:id="@+id/callContainer"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="end" android:background="?attr/selectableItemBackground"
            android:paddingEnd="10dp">
            <TextView android:id="@+id/tvCallLtp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textSize="14sp" android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/black" android:fontFamily="monospace"/>
            <TextView android:id="@+id/tvCallChange"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Strike (center) -->
        <TextView android:id="@+id/tvStrike"
            android:layout_width="86dp" android:layout_height="wrap_content"
            android:text="0" android:textSize="13.5sp" android:textStyle="bold"
            android:textColor="@color/bg_card" android:gravity="center"
            android:background="@drawable/bg_chip_off"
            android:paddingTop="4dp" android:paddingBottom="4dp"/>

        <!-- PUT side -->
        <LinearLayout
            android:id="@+id/putContainer"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="start" android:background="?attr/selectableItemBackground"
            android:paddingStart="10dp">
            <TextView android:id="@+id/tvPutLtp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textSize="14sp" android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/black" android:fontFamily="monospace"/>
            <TextView android:id="@+id/tvPutChange"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
