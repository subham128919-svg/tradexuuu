<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F3F3"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="34dp">

        <!-- ================================================= -->
        <!-- PREMIUM BRAND HEADER                              -->
        <!-- ================================================= -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/brandSection"
            android:layout_width="395dp"
            android:layout_height="250dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_login_hero"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:alpha="0.06"
                android:background="@drawable/up_trend_svgrepo_com"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:id="@+id/logoBox"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_logo_white"
                android:elevation="5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:contentDescription="TradeX logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/app_logo" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="TradeX"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/logoBox"
                app:layout_constraintTop_toTopOf="@id/logoBox" />

            <TextView
                android:id="@+id/tvBrandTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="5dp"
                android:includeFontPadding="false"
                android:text="Invest smarter. Trade better."
                android:textColor="#BDBDBD"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/logoBox"
                app:layout_constraintTop_toBottomOf="@id/tvBrand" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ================================================= -->
        <!-- LOGIN CARD                                         -->
        <!-- ================================================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/loginCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-32dp"
            android:elevation="10dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/brandSection">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="590dp"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="26dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back"
                    android:textColor="#0D0D0D"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Sign in to access your portfolio and markets."
                    android:textColor="#777777"
                    android:textSize="13sp"
                    android:includeFontPadding="false" />


                <!-- ============================================= -->
                <!-- EMAIL LABEL                                    -->
                <!-- ============================================= -->

                <TextView
                    android:id="@+id/labelEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="EMAIL ADDRESS"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:includeFontPadding="false" />


                <!-- ============================================= -->
                <!-- EMAIL FIELD                                    -->
                <!-- ============================================= -->

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="22dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/bg_login_input_accent" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="14dp"
                        android:background="@android:color/transparent"
                        android:hint="you@example.com"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:textColor="#0D0D0D"
                        android:textColorHint="#A0A0A0"
                        android:textSize="15sp" />

                </FrameLayout>


                <!-- ============================================= -->
                <!-- PASSWORD LABEL                                 -->
                <!-- ============================================= -->

                <TextView
                    android:id="@+id/labelPwd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="PASSWORD"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:includeFontPadding="false" />


                <!-- ============================================= -->
                <!-- PASSWORD FIELD                                 -->
                <!-- ============================================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_input"
                    app:boxBackgroundMode="none"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#333333">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="Enter your password"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="52dp"
                        android:textColor="#0D0D0D"
                        android:textColorHint="#A0A0A0"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ============================================= -->
                <!-- ERROR                                          -->
                <!-- ============================================= -->

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text=""
                    android:textColor="#B3261E"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:includeFontPadding="false"
                    tools:text="Incorrect email or password" />


                <!-- ============================================= -->
                <!-- SIGN IN BUTTON                                 -->
                <!-- ============================================= -->

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_login_button"
                    android:elevation="2dp"
                    android:minHeight="56dp"
                    android:stateListAnimator="@null"
                    android:text="Sign In"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />


                <!-- ============================================= -->
                <!-- SECURITY                                      -->
                <!-- ============================================= -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SECURE SIGN IN"
                        android:textColor="#666666"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:includeFontPadding="false" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_login_dot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROTECTED"
                        android:textColor="#999999"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:includeFontPadding="false" />

                </LinearLayout>


                <!-- ============================================= -->
                <!-- DIVIDER                                        -->
                <!-- ============================================= -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:background="#EEEEEE" />


                <!-- ============================================= -->
                <!-- SIGN UP                                        -->
                <!-- ============================================= -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New to TradeX?"
                        android:textColor="#777777"
                        android:textSize="13sp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/tvSignUp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Create account"
                        android:textColor="#0D0D0D"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ============================================= -->
        <!-- FOOTER                                         -->
        <!-- ============================================= -->

        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="TradeX  •  Professional trading platform"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loginCard" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>

