<?xml version="1.0" encoding="utf-8"?>
<!-- Holdings screen — rvHoldings + summary IDs required by HoldingsFragment.kt -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_summary"
            android:padding="20dp" android:layout_margin="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Current value" android:textSize="11sp" android:textColor="@color/t700"/>

            <!-- tvSummaryValue — REQUIRED ID -->
            <TextView android:id="@+id/tvSummaryValue"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="₹0.00" android:textSize="26sp" android:textStyle="bold"
                android:textColor="@color/t100" android:fontFamily="@font/jetbrains_mono"
                android:layout_marginTop="4dp"/>

            <!-- tvSummaryDelta — REQUIRED ID -->
            <TextView android:id="@+id/tvSummaryDelta"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="+₹0.00 (0.00%) today" android:textSize="12.5sp"
                android:textColor="@color/positive" android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="18dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Invested" android:textSize="11sp" android:textColor="@color/t700"/>
                    <!-- tvStat1Value — REQUIRED ID -->
                    <TextView android:id="@+id/tvStat1Value"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="₹0.00" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/t100" android:fontFamily="@font/jetbrains_mono"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Overall returns" android:textSize="11sp" android:textColor="@color/t700"/>
                    <!-- tvStat2Value — REQUIRED ID -->
                    <TextView android:id="@+id/tvStat2Value"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="+0.00%" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/positive" android:fontFamily="@font/jetbrains_mono"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- rvHoldings — REQUIRED ID, bound by LinearLayoutManager in HoldingsFragment.kt -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHoldings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:padding="8dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
