<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_surface">

    <!-- Header: Stock name + prices — id added for edge-to-edge inset padding -->
    <LinearLayout android:id="@+id/orderHeader"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="16dp" android:paddingBottom="14dp"
        android:background="@color/bg_item">

        <ImageView android:id="@+id/ivClose"
            android:tint="@color/t100"
            android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_back" android:layout_marginEnd="12dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvStockName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RELIANCE" android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/t100"/>
            <TextView android:id="@+id/tvPriceInfo"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="NSE ₹0.00" android:textSize="12sp" android:textColor="@color/t100"/>
        </LinearLayout>
        <TextView android:id="@+id/tvDepth"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Depth" android:textSize="13sp" android:textColor="@color/t100"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:background="@drawable/bg_chip_off"/>
    </LinearLayout>

    <!-- Order type tabs: Delivery | Intraday | MTF -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="14dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/tabDelivery"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Delivery" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/t100" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:background="@drawable/bg_chip_on" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/tabIntraday"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Intraday" android:textSize="13sp" android:textColor="@color/t600"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:background="@drawable/bg_chip_off" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/tabMtf"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MTF" android:textSize="13sp" android:textColor="@color/t600"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:background="@drawable/bg_chip_off"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/div07"/>

    <!-- Qty row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp">
        <TextView android:id="@+id/tvQtyLabel"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Qty" android:textSize="14sp" android:textColor="@color/t600"/>
        <TextView android:id="@+id/tvExchangeChip"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NSE" android:textSize="12sp" android:textColor="@color/t100"
            android:paddingStart="10dp" android:paddingEnd="20dp"
            android:paddingTop="5dp" android:paddingBottom="5dp"
            android:background="@drawable/bg_chip_off" android:layout_marginEnd="12dp"/>
        <TextView android:id="@+id/tvQtyDisplay"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center_vertical|end"
            android:hint="0" android:textColorHint="@color/t700"
            android:textSize="20sp" android:textStyle="bold" android:textColor="@color/t100"
            android:fontFamily="@font/jetbrains_mono"
            android:paddingEnd="4dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/div07"/>

    <!-- Price row — tvPriceTypeChip now toggles Market/Limit -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="12dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Price" android:textSize="14sp" android:textColor="@color/t600"/>
            <TextView android:id="@+id/tvPriceTypeChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Limit" android:textSize="12sp" android:textColor="@color/t100"
                android:paddingStart="10dp" android:paddingEnd="20dp"
                android:paddingTop="5dp" android:paddingBottom="5dp"
                android:background="@drawable/bg_chip_off" android:layout_marginEnd="12dp"/>
            <TextView android:id="@+id/tvPriceDisplay"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end"
                android:textSize="20sp" android:textStyle="bold"
                android:textColor="@color/t100" android:fontFamily="@font/jetbrains_mono"
                android:text="0.00"/>
        </LinearLayout>
        <TextView android:id="@+id/tvPriceHint"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="+0.00% from market" android:textSize="11.5sp" android:textColor="@color/t700"
            android:gravity="end" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/div07"/>

    <TextView android:id="@+id/tvOrderInfo"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Order will be executed at market price"
        android:textSize="12sp" android:textColor="@color/t700"
        android:gravity="center" android:padding="16dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingBottom="14dp">
        <TextView android:id="@+id/tvBalance"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Balance: ₹0.00" android:textSize="13sp" android:textColor="@color/t600"/>
        <TextView android:id="@+id/tvRequired"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Required: ₹0" android:textSize="13sp" android:textColor="@color/t600"/>
    </LinearLayout>

    <Button android:id="@+id/btnOrder"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="Buy" android:textSize="15sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:backgroundTint="@color/positive"
        android:stateListAnimator="@null"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="12dp"/>

    <!-- Numpad — id added for edge-to-edge bottom inset padding -->
    <GridLayout android:id="@+id/numpad"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:rowCount="4" android:columnCount="3"
        android:padding="4dp" android:background="@color/bg_item"/>

</LinearLayout>
