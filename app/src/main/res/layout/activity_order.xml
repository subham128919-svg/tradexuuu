<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ========================================================= -->
    <!-- HEADER                                                     -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/orderHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:background="#0D0D0D">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStockName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RELIANCE"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/tvPriceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="NSE  ₹0.00"
                android:textColor="#AFAFAF"
                android:textSize="12sp"
                android:includeFontPadding="false" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDepth"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:minWidth="74dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Depth"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_off"
            android:includeFontPadding="false" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- ORDER TYPE TABS                                            -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tabDelivery"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="Delivery"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_on"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tabIntraday"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="Intraday"
            android:textColor="#555555"
            android:textSize="13sp"
            android:background="@drawable/bg_chip_off"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tabMtf"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="MTF"
            android:textColor="#555555"
            android:textSize="13sp"
            android:background="@drawable/bg_chip_off"
            android:includeFontPadding="false" />

    </LinearLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E8E8" />


    <!-- ========================================================= -->
    <!-- QUANTITY                                                   -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvQtyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quantity"
                android:textColor="#242424"
                android:textSize="14sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Number of shares"
                android:textColor="#8A8A8A"
                android:textSize="11sp"
                android:includeFontPadding="false" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvExchangeChip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:minWidth="52dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="NSE"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_off"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tvQtyDisplay"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:gravity="center|end"
            android:hint="0"
            android:textColor="#0D0D0D"
            android:textColorHint="#B5B5B5"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="@font/jetbrains_mono"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:includeFontPadding="false" />

    </LinearLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E8E8" />


    <!-- ========================================================= -->
    <!-- PRICE                                                      -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price"
                    android:textColor="#242424"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Order execution price"
                    android:textColor="#8A8A8A"
                    android:textSize="11sp"
                    android:includeFontPadding="false" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvPriceTypeChip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:minWidth="58dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Limit"
                android:textColor="#303030"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_off"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvPriceDisplay"
                android:layout_width="104dp"
                android:layout_height="48dp"
                android:gravity="center|end"
                android:text="0.00"
                android:textColor="#0D0D0D"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="@font/jetbrains_mono"
                android:includeFontPadding="false" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvPriceHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:text="+0.00% from market"
            android:textColor="#8A8A8A"
            android:textSize="11sp"
            android:includeFontPadding="false" />

    </LinearLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E8E8" />


    <!-- ========================================================= -->
    <!-- ORDER INFORMATION                                          -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/tvOrderInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:gravity="center"
        android:text="Order will be executed at market price"
        android:textColor="#666666"
        android:textSize="12sp"
        android:background="#FAFAFA"
        android:includeFontPadding="false" />


    <!-- ========================================================= -->
    <!-- BALANCE / REQUIRED                                         -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balance: ₹0.00"
                android:textColor="#555555"
                android:textSize="12sp"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Available funds"
                android:textColor="#999999"
                android:textSize="10sp"
                android:includeFontPadding="false" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvRequired"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Required: ₹0"
                android:textColor="#555555"
                android:textSize="12sp"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Estimated order value"
                android:textColor="#999999"
                android:textSize="10sp"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- BUY BUTTON                                                 -->
    <!-- ========================================================= -->

    <Button
        android:id="@+id/btnOrder"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:text="Buy"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0D0D0D"
        android:stateListAnimator="@null"
        android:minHeight="54dp"
        android:includeFontPadding="false" />


    <!-- ========================================================= -->
    <!-- NUMPAD                                                     -->
    <!-- ========================================================= -->

    <GridLayout
        android:id="@+id/numpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:rowCount="4"
        android:columnCount="3"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="false"
        android:background="#F5F5F5" />

</LinearLayout>