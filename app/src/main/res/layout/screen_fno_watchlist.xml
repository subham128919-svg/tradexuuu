<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- ── Chips filter row ── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="22dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="2dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="My list 1" android:textSize="12sp" android:textColor="@color/chip_on_text"
                    android:background="@drawable/bg_chip_on"
                    android:paddingStart="13dp" android:paddingEnd="13dp"
                    android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:layout_marginEnd="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="My list 2" android:textSize="12sp" android:textColor="@color/chip_off_text"
                    android:background="@drawable/bg_chip_off"
                    android:paddingStart="13dp" android:paddingEnd="13dp"
                    android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:layout_marginEnd="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Long term" android:textSize="12sp" android:textColor="@color/chip_off_text"
                    android:background="@drawable/bg_chip_off"
                    android:paddingStart="13dp" android:paddingEnd="13dp"
                    android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:layout_marginEnd="8dp" />
            </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:layout_marginBottom="22dp">

            <!-- Section header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical|bottom"
                android:layout_marginBottom="11dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Watchlist" android:textSize="15.5sp" android:textStyle="bold"
                    android:textColor="@color/t100" android:letterSpacing="-0.01" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/accent" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_rows_wrap"
                android:clipToOutline="true">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="13dp" android:paddingBottom="13dp"
                    android:background="@drawable/bg_row">
                    <TextView android:layout_width="34dp" android:layout_height="34dp"
                        android:gravity="center" android:text="NF"
                        android:textSize="11.5sp" android:textStyle="bold"
                        android:textColor="@color/t400" android:background="@drawable/bg_logo"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="NIFTY 24400 CE" android:textSize="13sp" android:textColor="@color/t200"
                                android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="OI 68.4L · 28 Aug" android:textSize="10.5sp" android:textColor="@color/t800"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹142.55" android:textSize="13sp" android:textColor="@color/t200"
                            android:fontFamily="@font/jetbrains_mono" android:gravity="end" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="+14.70%" android:textSize="10.5sp" android:textColor="@color/positive"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/div06"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="13dp" android:paddingBottom="13dp"
                    android:background="@drawable/bg_row">
                    <TextView android:layout_width="34dp" android:layout_height="34dp"
                        android:gravity="center" android:text="BN"
                        android:textSize="11.5sp" android:textStyle="bold"
                        android:textColor="@color/t400" android:background="@drawable/bg_logo"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="BANKNIFTY 51300 PE" android:textSize="13sp" android:textColor="@color/t200"
                                android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="OI 22.8L · 28 Aug" android:textSize="10.5sp" android:textColor="@color/t800"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹268.90" android:textSize="13sp" android:textColor="@color/t200"
                            android:fontFamily="@font/jetbrains_mono" android:gravity="end" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="-13.30%" android:textSize="10.5sp" android:textColor="@color/negative"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/div06"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="13dp" android:paddingBottom="13dp"
                    android:background="@drawable/bg_row">
                    <TextView android:layout_width="34dp" android:layout_height="34dp"
                        android:gravity="center" android:text="FU"
                        android:textSize="11.5sp" android:textStyle="bold"
                        android:textColor="@color/t400" android:background="@drawable/bg_logo"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="RELIANCE AUG FUT" android:textSize="13sp" android:textColor="@color/t200"
                                android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Lot 500 · 28 Aug" android:textSize="10.5sp" android:textColor="@color/t800"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹2,954.20" android:textSize="13sp" android:textColor="@color/t200"
                            android:fontFamily="@font/jetbrains_mono" android:gravity="end" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="+0.68%" android:textSize="10.5sp" android:textColor="@color/positive"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/div06"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="13dp" android:paddingBottom="13dp"
                    android:background="@drawable/bg_row">
                    <TextView android:layout_width="34dp" android:layout_height="34dp"
                        android:gravity="center" android:text="FU"
                        android:textSize="11.5sp" android:textStyle="bold"
                        android:textColor="@color/t400" android:background="@drawable/bg_logo"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="TCS AUG FUT" android:textSize="13sp" android:textColor="@color/t200"
                                android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Lot 175 · 28 Aug" android:textSize="10.5sp" android:textColor="@color/t800"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹4,182.40" android:textSize="13sp" android:textColor="@color/t200"
                            android:fontFamily="@font/jetbrains_mono" android:gravity="end" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="-0.42%" android:textSize="10.5sp" android:textColor="@color/negative"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
