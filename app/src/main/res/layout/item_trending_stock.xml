<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_stock_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_ticker_badge"
        android:gravity="center"
        android:text="SB"
        android:textColor="#C7CDD6"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSymbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="SBIN"
        android:textColor="#C7CDD6"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Rs.1071.00"
        android:textColor="#F5F7FA"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvChangeAbs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="-26.20 (-2.39%)"
        android:textColor="#E74C3C"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
