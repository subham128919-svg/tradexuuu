<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_surface">

    <!-- Top bar: back | (spacer) | alarm | bookmark | search -->
    <LinearLayout android:id="@+id/chartTopBar"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="8dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="22dp"
            android:layout_height="13dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/t100"
            android:src="@drawable/ic_back" />
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
        <ImageView android:id="@+id/ivAlarm"
            android:layout_width="22dp" android:layout_height="22dp"
            android:backgroundTint="@color/ic_launcher_background"
            android:src="@drawable/alarm_clock_svgrepo_com" android:layout_marginEnd="16dp"/>
        <ImageView android:id="@+id/ivBookmark"
            android:tint="@color/t100"
            android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/bookmark_svgrepo_com__1_" android:layout_marginEnd="16dp"/>
        <ImageView android:id="@+id/ivSearch"
            android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_search"/>
    </LinearLayout>

    <!-- Stock logo + name + price block -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="4dp" android:paddingBottom="8dp">

        <!-- Square logo with initials -->
        <TextView android:id="@+id/tvLogo"
            android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/t100" android:background="@drawable/bg_logo"
            android:layout_marginEnd="12dp"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <!-- SYMBOL · NSE -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tvSymbol"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textStyle="bold" android:textColor="@color/t100"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" · " android:textSize="13sp" android:textColor="@color/t600"/>
                <TextView android:id="@+id/tvExchange"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="@color/t600"/>
            </LinearLayout>
            <!-- Full name -->
            <TextView android:id="@+id/tvName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/t700"
                android:layout_marginTop="1dp" android:singleLine="true"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">
            <!-- LTP -->
            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="—"
                android:textColor="@color/t100"
                android:textSize="18sp"
                android:textStyle="bold" />
            <!-- +123.45 (2.50%) -->
            <TextView android:id="@+id/tvChange"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/positive"
                android:fontFamily="@font/jetbrains_mono"/>
        </LinearLayout>
    </LinearLayout>

    <!-- OHLV stats bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="26dp"
        android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:gravity="center_vertical">
        <TextView android:id="@+id/tvOhlv"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="10.5sp" android:textColor="@color/t700"
            android:fontFamily="@font/jetbrains_mono"
            android:text="O — H — L — Vol —"/>
    </LinearLayout>

    <!-- WebView chart (takes most of the screen) -->
    <WebView android:id="@+id/chartWebView"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Period buttons: 1D 1W 1M 3M 6M 1Y 5Y All -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="40dp"
        android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:id="@+id/periodContainer">
            <!-- Each TextView has android:tag matching the period string -->
            <TextView android:tag="1D" android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="1D" android:gravity="center" android:textSize="13sp"
                android:textColor="@color/t600" android:minWidth="36dp"
                android:background="@drawable/bg_chip_off" android:layout_marginEnd="4dp"
                android:paddingStart="10dp" android:paddingEnd="10dp"/>
            <TextView android:tag="1W" android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="1W" android:gravity="center" android:textSize="13sp"
                android:textColor="@color/t600" android:minWidth="36dp"
                android:background="@drawable/bg_chip_off" android:layout_marginEnd="4dp"
                android:paddingStart="10dp" android:paddingEnd="10dp"/>
            <TextView android:tag="1M" android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="1M" android:gravity="center" android:textSize="13sp"
                android:textColor="@color/t600" android:minWidth="36dp"
                android:background="@drawable/bg_chip_off" android:layout_marginEnd="4dp"
                android:paddingStart="10dp" android:paddingEnd="10dp"/>
            <TextView android:tag="3M" android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="3M" android:gravity="center" android:textSize="13sp"
                android:textColor="@color/t600" android:minWidth="36dp"
                android:background="@drawable/bg_chip_off" android:layout_marginEnd="4dp"
                android:paddingStart="10dp" android:paddingEnd="10dp"/>
            <TextView android:tag="6M" android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="6M" android:gravity="center" android:textSize="13sp"
                android:textColor="@color/t600" android:minWidth="36dp"
                android:background="@drawable/bg_chip_off" android:layout_marginEnd="4dp"
                android:paddingStart="10dp" android:paddingEnd="10dp"/>
            <TextView android:tag="1Y" android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="1Y" android:gravity="center" android:textSize="13sp"
                android:textColor="@color/t600" android:minWidth="36dp"
                android:background="@drawable/bg_chip_off" android:layout_marginEnd="4dp"
                android:paddingStart="10dp" android:paddingEnd="10dp"/>
            <TextView android:tag="5Y" android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="5Y" android:gravity="center" android:textSize="13sp"
                android:textColor="@color/t600" android:minWidth="36dp"
                android:background="@drawable/bg_chip_off" android:layout_marginEnd="4dp"
                android:paddingStart="10dp" android:paddingEnd="10dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom action bar: SIP | Sell | Buy -->
    <LinearLayout android:id="@+id/chartBottomBar"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingBottom="6dp" android:gravity="center_vertical"
        android:background="@color/bg_item">
        <Button android:id="@+id/btnSip"
            android:layout_width="64dp" android:layout_height="40dp"
            android:text="SIP" android:textSize="13sp" android:textColor="@color/t100"
            android:backgroundTint="@color/bg_card" android:stateListAnimator="@null"
            android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnSell"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:text="Sell" android:textSize="14sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:backgroundTint="@color/negative"
            android:stateListAnimator="@null" android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnBuy"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:text="Buy" android:textSize="14sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:backgroundTint="@color/positive"
            android:stateListAnimator="@null"/>
    </LinearLayout>

</LinearLayout>
