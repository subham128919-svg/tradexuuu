<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">


    <!-- ========================================================= -->
    <!-- TOP BAR                                                    -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/chartTopBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="3dp"
        android:background="@color/black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivAlarm"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:contentDescription="Price alert"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/alarm_clock_alt_svgrepo_com"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/ivBookmark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:contentDescription="Watchlist"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/bookmark_svgrepo_com"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:contentDescription="Search"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_search"
            android:tint="#FFFFFF" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- STOCK HEADER                                                -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="1dp"
        android:paddingBottom="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="13dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_logo"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvSymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0D0D0D"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ·  "
                    android:textSize="13sp"
                    android:textColor="#A0A0A0"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvExchange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:includeFontPadding="false" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="#858585"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#0D0D0D"
                android:fontFamily="@font/jetbrains_mono"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="#222222"
                android:fontFamily="@font/jetbrains_mono"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- OHLV STATS                                                 -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#F7F7F7">

        <TextView
            android:id="@+id/tvOhlv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O —   H —   L —   Vol —"
            android:textSize="10.5sp"
            android:textColor="#666666"
            android:fontFamily="@font/jetbrains_mono"
            android:includeFontPadding="false" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- CHART                                                      -->
    <!-- ========================================================= -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <WebView
            android:id="@+id/chartWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />

    </FrameLayout>


    <!-- ========================================================= -->
    <!-- TIME FRAME SELECTOR                                        -->
    <!-- ========================================================= -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/periodContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:tag="1D"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="44dp"
                android:gravity="center"
                android:text="1D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_chart_period_active"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false" />

            <TextView
                android:tag="1W"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="44dp"
                android:gravity="center"
                android:text="1W"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:background="@drawable/bg_chart_period"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false" />

            <TextView
                android:tag="1M"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="44dp"
                android:gravity="center"
                android:text="1M"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:background="@drawable/bg_chart_period"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false" />

            <TextView
                android:tag="3M"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="44dp"
                android:gravity="center"
                android:text="3M"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:background="@drawable/bg_chart_period"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false" />

            <TextView
                android:tag="6M"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="44dp"
                android:gravity="center"
                android:text="6M"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:background="@drawable/bg_chart_period"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false" />

            <TextView
                android:tag="1Y"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="44dp"
                android:gravity="center"
                android:text="1Y"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:background="@drawable/bg_chart_period"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false" />

            <TextView
                android:tag="5Y"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="44dp"
                android:gravity="center"
                android:text="5Y"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:background="@drawable/bg_chart_period"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:includeFontPadding="false" />

        </LinearLayout>

    </HorizontalScrollView>


    <!-- ========================================================= -->
    <!-- BOTTOM ACTION BAR                                          -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/chartBottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#0D0D0D">

        <Button
            android:id="@+id/btnOptionChain"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Options"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#242424"
            android:stateListAnimator="@null"
            android:visibility="gone"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnSell"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="Sell"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:stateListAnimator="@null"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnBuy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="Buy"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0D0D0D"
            android:backgroundTint="#FFFFFF"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>