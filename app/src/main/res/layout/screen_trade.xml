<?xml version="1.0" encoding="utf-8"?>
<!--
  TradeActivity layout — place buy/sell order
  Fields: Quantity, Price (LIMIT only), Product (MIS/CNC/NRML), Order type (MARKET/LIMIT)
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="16dp"  android:paddingBottom="24dp">

        <!-- Close button -->
        <ImageView android:id="@+id/ivClose"
            android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_back"
            android:imageTintList="@color/t400"
            android:contentDescription="Close"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Symbol + BUY/SELL label -->
        <LinearLayout android:id="@+id/headerRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingTop="6dp" android:paddingBottom="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView android:id="@+id/tvSymbol"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RELIANCE"
                android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/t100"/>

            <TextView android:id="@+id/tvType"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="BUY"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/positive"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:paddingTop="6dp"   android:paddingBottom="6dp"
                android:background="@drawable/bg_tag_buy"/>
        </LinearLayout>

        <!-- Quantity -->
        <TextView android:id="@+id/labelQty"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Quantity"
            android:textSize="12sp" android:textColor="@color/t700"
            android:paddingBottom="6dp"
            app:layout_constraintTop_toBottomOf="@id/headerRow"/>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:hint="1"
            android:inputType="number"
            android:textSize="15sp" android:textColor="@color/t100"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:background="@drawable/bg_card"
            app:layout_constraintTop_toBottomOf="@id/labelQty"/>

        <!-- Price (visible only for LIMIT) -->
        <TextView android:id="@+id/labelPrice"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Price"
            android:textSize="12sp" android:textColor="@color/t700"
            android:paddingTop="16dp" android:paddingBottom="6dp"
            app:layout_constraintTop_toBottomOf="@id/etQuantity"/>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:hint="Market price"
            android:inputType="numberDecimal"
            android:textSize="15sp" android:textColor="@color/t100"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:background="@drawable/bg_card"
            app:layout_constraintTop_toBottomOf="@id/labelPrice"/>

        <!-- Product type -->
        <TextView android:id="@+id/labelProduct"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Product"
            android:textSize="12sp" android:textColor="@color/t700"
            android:paddingTop="20dp" android:paddingBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/etPrice"/>

        <RadioGroup android:id="@+id/rgProduct"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/labelProduct">

            <RadioButton android:id="@+id/rbMis" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="MIS" android:textColor="@color/t200"
                android:textSize="13sp" android:buttonTint="@color/accent" android:checked="true"/>
            <RadioButton android:id="@+id/rbCnc" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="CNC" android:textColor="@color/t200"
                android:textSize="13sp" android:buttonTint="@color/accent"/>
            <RadioButton android:id="@+id/rbNrml" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="NRML" android:textColor="@color/t200"
                android:textSize="13sp" android:buttonTint="@color/accent"/>
        </RadioGroup>

        <!-- Order type -->
        <TextView android:id="@+id/labelOrderType"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Order type"
            android:textSize="12sp" android:textColor="@color/t700"
            android:paddingTop="20dp" android:paddingBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/rgProduct"/>

        <RadioGroup android:id="@+id/rgOrderType"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/labelOrderType">

            <RadioButton android:id="@+id/rbMarket" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Market" android:textColor="@color/t200"
                android:textSize="13sp" android:buttonTint="@color/accent" android:checked="true"/>
            <RadioButton android:id="@+id/rbLimit" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Limit" android:textColor="@color/t200"
                android:textSize="13sp" android:buttonTint="@color/accent"/>
            <RadioButton android:id="@+id/rbSl" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="SL" android:textColor="@color/t200"
                android:textSize="13sp" android:buttonTint="@color/accent"/>
        </RadioGroup>

        <!-- Place order button -->
        <Button android:id="@+id/btnOrder"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="BUY"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:backgroundTint="@color/positive"
            android:letterSpacing="0.06"
            android:layout_marginTop="28dp"
            android:stateListAnimator="@null"
            app:layout_constraintTop_toBottomOf="@id/rgOrderType"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
