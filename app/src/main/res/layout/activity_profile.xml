<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black" android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="32dp">

        <!-- Header bar -->
        <LinearLayout android:id="@+id/profileHeader"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="15dp">
            <ImageView android:id="@+id/ivBack"
                android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_back"/>
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
            <ImageView android:id="@+id/ivBell"
                android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/appicon__2__removebg_preview" android:layout_marginEnd="18dp"/>
            <ImageView android:id="@+id/ivSettings"
                android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/appicon__2__removebg_preview"/>
        </LinearLayout>

        <!-- Avatar circle with initials -->
        <FrameLayout android:layout_width="96dp" android:layout_height="96dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="24dp">
            <TextView android:id="@+id/tvInitials"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:textSize="32sp" android:textStyle="bold"
                android:textColor="#9B7EF8" android:background="@drawable/app_logo"/>
        </FrameLayout>

        <!-- User name -->
        <TextView android:id="@+id/tvUserName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Your Name" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/black" android:layout_marginTop="12dp"/>

        <TextView android:id="@+id/tvUserEmail"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="" android:textSize="12sp" android:textColor="@color/t700"
            android:layout_marginTop="2dp" android:layout_marginBottom="24dp"/>

        <!-- Wallet card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@color/black"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/appicon__2__removebg_preview" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0.00"
                    android:textColor="@color/t100"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stocks, F&amp;O balance"
                    android:textColor="@color/t700"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAddMoney"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/positive"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"
                android:text="+ Add money"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="8dp"
            android:background="@color/black"/>

        <!-- Menu items -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/bg_item">

            <!-- Orders -->
            <LinearLayout android:id="@+id/rowOrders"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp">
                <TextView android:layout_width="24dp" android:layout_height="24dp"
                    android:text="📋" android:textSize="16sp" android:gravity="center"
                    android:layout_marginEnd="14dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Orders" android:textSize="14.5sp" android:textColor="@color/t100"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="@color/div06" android:layout_marginStart="58dp"/>

            <!-- Reports -->
            <LinearLayout android:id="@+id/rowReports"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp">
                <TextView android:layout_width="24dp" android:layout_height="24dp"
                    android:text="📄" android:textSize="16sp" android:gravity="center"
                    android:layout_marginEnd="14dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reports" android:textSize="14.5sp" android:textColor="@color/t100"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="File tax ›" android:textSize="12sp" android:textColor="@color/positive"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"
                    android:background="@drawable/bg_chip_off"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="@color/div06" android:layout_marginStart="58dp"/>

            <!-- Account details -->
            <LinearLayout android:id="@+id/rowAccount"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp">
                <TextView android:layout_width="24dp" android:layout_height="24dp"
                    android:text="👤" android:textSize="16sp" android:gravity="center"
                    android:layout_marginEnd="14dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Account details" android:textSize="14.5sp" android:textColor="@color/t100"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="@color/div06" android:layout_marginStart="58dp"/>

            <!-- Refer & Invite -->
            <LinearLayout android:id="@+id/rowRefer"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp">
                <TextView android:layout_width="24dp" android:layout_height="24dp"
                    android:text="❤️" android:textSize="16sp" android:gravity="center"
                    android:layout_marginEnd="14dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Refer &amp; Invite" android:textSize="14.5sp" android:textColor="@color/t100"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="@color/div06" android:layout_marginStart="58dp"/>

            <!-- Customer support -->
            <LinearLayout android:id="@+id/rowSupport"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp">
                <TextView android:layout_width="24dp" android:layout_height="24dp"
                    android:text="🎧" android:textSize="16sp" android:gravity="center"
                    android:layout_marginEnd="14dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Customer support 24x7" android:textSize="14.5sp" android:textColor="@color/t100"/>
            </LinearLayout>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="8dp"
            android:background="@color/black"/>

        <!-- Logout -->
        <LinearLayout android:id="@+id/rowLogout"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:background="@color/bg_item">
            <TextView android:layout_width="24dp" android:layout_height="24dp"
                android:text="🚪" android:textSize="16sp" android:gravity="center"
                android:layout_marginEnd="14dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Sign out" android:textSize="14.5sp" android:textColor="@color/negative"/>
        </LinearLayout>

        <!-- Footer -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal" android:gravity="center"
            android:layout_marginTop="32dp">
            <TextView android:id="@+id/tvAbout"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="About Us" android:textSize="12.5sp" android:textColor="@color/t500"
                android:textStyle="bold"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⊙" android:textSize="16sp" android:textColor="@color/t500"
                    android:gravity="center"/>
                <TextView android:id="@+id/tvVersion"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="v1.0.0" android:textSize="11sp" android:textColor="@color/t700"
                    android:gravity="center"/>
            </LinearLayout>
            <TextView android:id="@+id/tvCharges"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="Charges" android:textSize="12.5sp" android:textColor="@color/t500"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
