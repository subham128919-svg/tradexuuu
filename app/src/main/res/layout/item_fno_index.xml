<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="15dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp">


        <!-- ================================================= -->
        <!-- INDEX SYMBOL TILE                                 -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvLogo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="13dp"
            android:gravity="center"
            android:text="NI"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_fno_index_logo"
            android:includeFontPadding="false" />


        <!-- ================================================= -->
        <!-- NAME / EXCHANGE                                   -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NIFTY 50"
                android:textColor="#151515"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NSE"
                    android:textColor="#777777"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_fno_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INDEX"
                    android:textColor="#9A9A9A"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:includeFontPadding="false" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- PRICE / CHANGE                                     -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/jetbrains_mono"
                android:gravity="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvRightSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:minWidth="62dp"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="+0.00%"
                android:textColor="#2E9B5F"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/jetbrains_mono"
                android:background="@drawable/bg_fno_change_neutral"
                android:includeFontPadding="false" />

        </LinearLayout>


        <!-- Chevron -->

        <TextView
            android:layout_width="20dp"
            android:layout_height="42dp"
            android:layout_marginStart="7dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#B0B0B0"
            android:textSize="22sp"
            android:includeFontPadding="false" />

    </LinearLayout>

</androidx.cardview.widget.CardView>