<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ══ Status bar (legacy custom mimic — kept hidden, real edge-to-edge
         status bar is handled in code via WindowInsetsControllerCompat) ══ -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="10dp"   android:paddingBottom="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="9:41"
            android:visibility="gone"
            android:textSize="11sp" android:textColor="@color/t600"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="5G"
            android:textSize="11sp" android:textColor="@color/t600"
            android:fontFamily="monospace"
            android:layout_marginEnd="6dp" />

        <FrameLayout android:layout_width="20dp" android:layout_height="10dp">
            <View android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_battery" />
            <View android:layout_width="11dp" android:layout_height="6dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="1.5dp"
                android:visibility="gone"
                android:background="@color/t600" />
        </FrameLayout>
    </LinearLayout>

    <!-- ══ App header ══ -->
    <LinearLayout
        android:id="@+id/appHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/black"
        android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="10dp"   android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="33dp"
            android:layout_height="34dp"
            android:layout_marginEnd="11dp"
            android:background="@drawable/app_logo">

            <View
                android:layout_width="10dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:rotation="45" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSegTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.01"
                android:text="TradeX"
                android:visibility="gone"
                android:textColor="@color/t100"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.01"
                android:text="TradeX"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSegSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.01"
                android:text="Equity · NSE / BSE"
                android:textColor="@color/white"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search"
            android:padding="6dp"
            android:src="@drawable/ic_search"
            android:tint="@color/white" />

        <!-- NEW — vertical divider between search and avatar, per design -->
        <View
            android:id="@+id/divHeaderSearchAvatar"
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginEnd="12dp"
            android:background="@color/div12" />

        <!-- NEW — avatar wrapped so an online-status dot can sit on top of it -->
        <FrameLayout
            android:id="@+id/avatarWrap"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Profile">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="30dp" android:layout_height="30dp"
                android:text="RJ" android:gravity="center"
                android:textSize="11sp" android:textStyle="bold"
                android:textColor="@color/t_avatar"
                android:background="@drawable/bg_avatar" />

            <!-- NEW — green dot shown while the user has a valid session -->
            <View
                android:id="@+id/dotOnline"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_dot" />
        </FrameLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hsvTicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="visible"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="2dp"    android:paddingBottom="11dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/llIndices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View android:id="@+id/divTicker"
        android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/div06"
        app:layout_constraintTop_toBottomOf="@id/hsvTicker"
        app:layout_constraintStart_toStartOf="parent" />

    <HorizontalScrollView
        android:id="@+id/hsvTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        app:layout_constraintTop_toBottomOf="@id/divTicker"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/llTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View android:id="@+id/divTabs"
        android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/hsvTabs"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ══ Bottom nav — redesigned as two floating rounded pill buttons ══ -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divTabs"
        app:layout_constraintVertical_bias="0.0" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="8dp"    android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navStocks"
            android:layout_width="0dp" android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:elevation="3dp"
            android:background="@drawable/bg_nav_pill"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true" android:focusable="true">

            <FrameLayout
                android:id="@+id/navIconBgStocks"
                android:layout_width="24dp" android:layout_height="20dp"
                android:background="@android:color/transparent">

                <View
                    android:layout_width="18dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:background="@drawable/up_trend_svgrepo_com" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavStocks"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Stocks"
                android:textSize="10.5sp" android:textStyle="bold"
                android:textColor="@color/t100"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navFno"
            android:layout_width="0dp" android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:elevation="3dp"
            android:background="@drawable/bg_nav_pill"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true" android:focusable="true">

            <FrameLayout
                android:id="@+id/navIconBgFno"
                android:layout_width="24dp" android:layout_height="20dp"
                android:background="@android:color/transparent">

                <View
                    android:layout_width="19dp"
                    android:layout_height="15dp"
                    android:backgroundTint="#F8F8F8"
                    android:layout_gravity="center"
                    android:background="@drawable/diagram_bar_downtrend_2_svgrepo_com" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavFno"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="F&amp;O"
                android:textSize="10.5sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <!-- Mutual Funds segment — kept fully wired for when it's needed,
             hidden so the bottom nav matches the 2-tab design exactly. -->
        <LinearLayout
            android:id="@+id/navFunds"
            android:layout_width="0dp" android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:visibility="gone"
            android:orientation="vertical"
            android:gravity="center"
            android:elevation="3dp"
            android:background="@drawable/bg_nav_pill"
            android:clickable="true" android:focusable="true">

            <FrameLayout
                android:id="@+id/navIconBgFunds"
                android:layout_width="24dp" android:layout_height="20dp"
                android:background="@android:color/transparent">

                <View
                    android:layout_width="9dp" android:layout_height="9dp"
                    android:layout_gravity="center"
                    android:background="@drawable/nav_dot_rect" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavFunds"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Funds"
                android:textSize="10.5sp"
                android:textColor="@color/t800"
                android:layout_marginTop="5dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>