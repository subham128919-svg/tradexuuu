<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ========================================================= -->
    <!-- APP HEADER                                                  -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/appHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0D0D0D"
        android:paddingStart="18dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="13dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo -->

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/app_logo">

            <View
                android:layout_width="10dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:rotation="45" />

        </FrameLayout>


        <!-- Brand -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSegTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TradeX"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TradeX"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvSegSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Equity · NSE / BSE"
                android:textColor="#AFAFAF"
                android:textSize="10.5sp"
                android:includeFontPadding="false" />

        </LinearLayout>


        <!-- Search -->

        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_search"
            android:tint="#FFFFFF"
            android:contentDescription="Search"
            android:clickable="true"
            android:focusable="true" />


        <!-- Divider -->

        <View
            android:id="@+id/divHeaderSearchAvatar"
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:background="#383838" />


        <!-- Avatar -->

        <FrameLayout
            android:id="@+id/avatarWrap"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Profile">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="RJ"
                android:textColor="#111111"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_avatar" />

            <View
                android:id="@+id/dotOnline"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_dot" />

        </FrameLayout>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- MARKET INDEX TICKER                                        -->
    <!-- ========================================================= -->

    <HorizontalScrollView
        android:id="@+id/hsvTicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:background="#FFFFFF"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/llIndices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>


    <View
        android:id="@+id/divTicker"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E8E8"
        app:layout_constraintTop_toBottomOf="@id/hsvTicker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================================= -->
    <!-- MAIN CATEGORY TABS                                         -->
    <!-- ========================================================= -->

    <HorizontalScrollView
        android:id="@+id/hsvTabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:background="#FFFFFF"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        app:layout_constraintTop_toBottomOf="@id/divTicker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/llTabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

    </HorizontalScrollView>


    <View
        android:id="@+id/divTabs"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E8E8"
        app:layout_constraintTop_toBottomOf="@id/hsvTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================================= -->
    <!-- FRAGMENT HOST                                               -->
    <!-- ========================================================= -->

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/divTabs"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================================= -->
    <!-- BOTTOM SEGMENT NAVIGATION                                  -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_marginBottom="15dp"
        android:background="@color/black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="3dp"
        android:paddingEnd="14dp"
        android:paddingBottom="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Stocks -->

        <LinearLayout
            android:id="@+id/navStocks"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navIconBgStocks"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:background="@android:color/transparent">

                <View
                    android:layout_width="18dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:background="@drawable/up_trend_svgrepo_com" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvNavStocks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:text="Stocks"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- F&O -->

        <LinearLayout
            android:id="@+id/navFno"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navIconBgFno"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:background="@android:color/transparent">

                <View
                    android:layout_width="19dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:background="@drawable/diagram_bar_downtrend_2_svgrepo_com" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvNavFno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:text="F&amp;O"
                android:textColor="#777777"
                android:textSize="10.5sp" />

        </LinearLayout>


        <!-- Funds -->

        <LinearLayout
            android:id="@+id/navFunds"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/navIconBgFunds"
                android:layout_width="24dp"
                android:layout_height="20dp">

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="center"
                    android:background="@drawable/nav_dot_rect" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvNavFunds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:text="Funds"
                android:textColor="#777777"
                android:textSize="10.5sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>