<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F8FB"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:id="@+id/fundsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#101D32">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:padding="13dp"
            android:src="@drawable/funds_ic_close"
            android:background="@drawable/funds_bg_close"
            android:contentDescription="@string/funds_close"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/funds_title"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/funds_header_caption"
                android:textSize="12sp"
                android:textColor="#AEBCCF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scroll only when available height or font size requires it. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/funds_bg_balance"
                android:padding="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/funds_wallet"
                            android:textSize="11sp"
                            android:letterSpacing="0.10"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#75DCC5" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/funds_balance"
                            android:textSize="14sp"
                            android:textColor="#CBD6E5" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="104dp"
                        android:layout_height="80dp"
                        android:src="@drawable/funds_art_trading_wallet"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvCurrentBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="₹0.00"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:breakStrategy="simple"
                    android:textColor="#FFFFFF" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="13dp"
                    android:background="#30435C" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/funds_balance_caption"
                    android:textSize="12sp"
                    android:textColor="#AEBED2" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:labelFor="@id/etAmount"
                android:text="@string/funds_enter_amount"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#142139" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/funds_bg_amount"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="₹"
                    android:textSize="32sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#087D6B" />
                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="56dp"
                    android:padding="0dp"
                    android:background="@null"
                    android:hint="0"
                    android:inputType="number"
                    android:maxLength="6"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="32sp"
                    android:textColor="#142139"
                    android:textColorHint="#7D8BA0" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/funds_amount_limits"
                android:textSize="12sp"
                android:textColor="#596B82" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/funds_quick_amount"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#596B82" />
            <LinearLayout
                android:id="@+id/quickAmountContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="10dp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/funds_bg_error"
                android:padding="12dp"
                android:textColor="#AC2939"
                android:textSize="13sp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/funds_bg_note"
                android:padding="14dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/funds_ic_payment"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/funds_payment_note"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#466476" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- The Activity applies navigation-bar and keyboard insets here. -->
    <LinearLayout
        android:id="@+id/fundsFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F6F8FB"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAddMoney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/funds_bg_button"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/funds_add_money"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/funds_footer_note"
            android:textSize="11sp"
            android:textColor="#596B82" />
    </LinearLayout>
</LinearLayout>
