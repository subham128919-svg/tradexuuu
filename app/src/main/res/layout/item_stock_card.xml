<?xml version="1.0" encoding="utf-8"?>
<!-- 2-column stock/fund card. Populate via adapter in a 2-col GridLayoutManager. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_card">

    <TextView android:id="@+id/tvLogo"
        android:layout_width="32dp" android:layout_height="32dp"
        android:gravity="center"
        android:text="TP" android:textSize="12sp" android:textStyle="bold"
        android:textColor="@color/t400"
        android:background="@android:color/transparent"
        android:layout_marginBottom="12dp" />

    <TextView android:id="@+id/tvName"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Tata Power"
        android:textSize="12.5sp" android:textColor="@color/t300"
        android:singleLine="true" android:ellipsize="end"
        android:layout_marginBottom="9dp" />

    <TextView android:id="@+id/tvPrice"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="₹428.90"
        android:textSize="14sp" android:textColor="@color/t100"
        android:fontFamily="@font/jetbrains_mono" />

    <TextView android:id="@+id/tvChange"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="+13.75 (3.31%)"
        android:textSize="11sp" android:textColor="@color/positive"
        android:fontFamily="@font/jetbrains_mono"
        android:layout_marginTop="3dp" />
</LinearLayout>
