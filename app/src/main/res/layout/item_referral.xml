<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:id="@+id/tvReferralName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#14141F" android:textSize="14sp" android:textStyle="bold" />

            <TextView android:id="@+id/tvReferralSub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8A8A9C" android:textSize="11.5sp" />

        </LinearLayout>

        <TextView android:id="@+id/tvReferralBadge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_amber"
            android:paddingStart="11dp" android:paddingEnd="11dp"
            android:paddingTop="5dp" android:paddingBottom="5dp"
            android:textColor="#FFFFFF" android:textSize="10.5sp" android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
