<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Sync error banner — hidden unless there's an error -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="12sp" android:textColor="@color/negative"
            android:gravity="center" android:padding="12dp"
            android:background="@color/bg_item"/>

        <!-- ── Top Gainers section ── -->
        <LinearLayout
            android:id="@+id/layoutGainers"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="0dp"
            android:paddingTop="14dp" android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingEnd="16dp" android:paddingBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Top Gainers"
                    android:textSize="13.5sp" android:textStyle="bold" android:textColor="@color/t100"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Previous day" android:textSize="10.5sp" android:textColor="@color/t700"/>
            </LinearLayout>

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:scrollbars="none" android:paddingEnd="16dp" android:clipToPadding="false">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvGainers"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:nestedScrollingEnabled="false"/>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ── Top Losers section ── -->
        <LinearLayout
            android:id="@+id/layoutLosers"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="0dp"
            android:paddingTop="14dp" android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingEnd="16dp" android:paddingBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Top Losers"
                    android:textSize="13.5sp" android:textStyle="bold" android:textColor="@color/t100"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Previous day" android:textSize="10.5sp" android:textColor="@color/t700"/>
            </LinearLayout>

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:scrollbars="none" android:paddingEnd="16dp" android:clipToPadding="false">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLosers"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:nestedScrollingEnabled="false"/>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Divider before main grid -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/div06"
            android:layout_marginTop="12dp" android:layout_marginBottom="4dp"/>

        <!-- ── Filter chips ── -->
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="8dp" android:paddingBottom="10dp">
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:id="@+id/chipTrending"
                    android:text="Trending" android:textSize="12.5sp" android:textStyle="bold"
                    android:textColor="@color/t100"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:background="@drawable/bg_chip_on" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:id="@+id/chipGainers"
                    android:text="Gainers" android:textSize="12.5sp" android:textColor="@color/t100"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:background="@drawable/bg_chip_off" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:id="@+id/chipLosers"
                    android:text="Losers" android:textSize="12.5sp" android:textColor="@color/t100"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:background="@drawable/bg_chip_off"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ── Main 2-col stock grid ── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:clipToPadding="false"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
