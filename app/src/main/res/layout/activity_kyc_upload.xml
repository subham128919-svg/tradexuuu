<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Document Verification"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Upload your identity documents for account verification"
            android:textColor="#777777"
            android:textSize="13sp" />

        <!-- ============================================= -->
        <!-- PAN CARD SECTION                               -->
        <!-- ============================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="PAN CARD"
            android:textColor="#555555"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- PAN Front -->
            <FrameLayout
                android:id="@+id/boxPanFront"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_upload_box"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivPanFront"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/tvPanFrontLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Front Side"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                </LinearLayout>

            </FrameLayout>

            <!-- PAN Back -->
            <FrameLayout
                android:id="@+id/boxPanBack"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_upload_box"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivPanBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/tvPanBackLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Back Side"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- PAN Number input -->
        <EditText
            android:id="@+id/etPanNumber"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_login_input"
            android:hint="Enter PAN Number (e.g., ABCDE1234F)"
            android:inputType="textCapCharacters"
            android:maxLength="10"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#0D0D0D"
            android:textColorHint="#A0A0A0"
            android:textSize="14sp" />


        <!-- ============================================= -->
        <!-- AADHAAR CARD SECTION                           -->
        <!-- ============================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="AADHAAR CARD"
            android:textColor="#555555"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Aadhaar Front -->
            <FrameLayout
                android:id="@+id/boxAadhaarFront"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_upload_box"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivAadhaarFront"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/tvAadhaarFrontLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Front Side"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                </LinearLayout>

            </FrameLayout>

            <!-- Aadhaar Back -->
            <FrameLayout
                android:id="@+id/boxAadhaarBack"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_upload_box"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivAadhaarBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/tvAadhaarBackLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Back Side"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- Aadhaar Number input -->
        <EditText
            android:id="@+id/etAadhaarNumber"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_login_input"
            android:hint="Enter Aadhaar Number (12 digits)"
            android:inputType="number"
            android:maxLength="14"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#0D0D0D"
            android:textColorHint="#A0A0A0"
            android:textSize="14sp" />

        <!-- Error -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#B3261E"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Proceed button -->
        <Button
            android:id="@+id/btnProceed"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_login_button"
            android:text="Proceed to Preview"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:elevation="2dp"
            android:stateListAnimator="@null" />

        <View android:layout_width="1dp" android:layout_height="24dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
