<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- ── Summary block ── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" android:paddingBottom="6dp"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_summary">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Monthly SIP amount" android:textSize="11sp"
                android:textColor="@color/t600" android:letterSpacing="0.03"
                android:layout_marginBottom="5dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical|bottom"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="₹34,000" android:textSize="26sp" android:textColor="@color/t100"
                    android:fontFamily="@font/jetbrains_mono" android:letterSpacing="-0.02"
                    android:layout_marginEnd="9dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Next debit 5 Aug · 4 active" android:textSize="12sp" android:textColor="@color/positive"
                    android:fontFamily="@font/jetbrains_mono" />
            </LinearLayout>

            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:columnCount="2" android:rowCount="2"
                android:layout_marginBottom="10dp"
                android:background="@color/div06">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:orientation="vertical"
                            android:padding="11dp" android:paddingStart="13dp"
                            android:background="@drawable/bg_stat_cell" android:layout_margin="0.5dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="ACTIVE SIPS" android:textSize="10sp"
                                android:textColor="@color/t800" android:letterSpacing="0.04"
                                android:layout_marginBottom="4dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="4" android:textSize="13sp" android:textColor="@color/black"
                                android:fontFamily="@font/jetbrains_mono" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:orientation="vertical"
                            android:padding="11dp" android:paddingStart="13dp"
                            android:background="@drawable/bg_stat_cell" android:layout_margin="0.5dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="TOTAL INVESTED" android:textSize="10sp"
                                android:textColor="@color/t800" android:letterSpacing="0.04"
                                android:layout_marginBottom="4dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="₹4,08,000" android:textSize="13sp" android:textColor="@color/black"
                                android:fontFamily="@font/jetbrains_mono" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:orientation="vertical"
                            android:padding="11dp" android:paddingStart="13dp"
                            android:background="@drawable/bg_stat_cell" android:layout_margin="0.5dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="CURRENT VALUE" android:textSize="10sp"
                                android:textColor="@color/t800" android:letterSpacing="0.04"
                                android:layout_marginBottom="4dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="₹5,12,640" android:textSize="13sp" android:textColor="@color/positive"
                                android:fontFamily="@font/jetbrains_mono" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:orientation="vertical"
                            android:padding="11dp" android:paddingStart="13dp"
                            android:background="@drawable/bg_stat_cell" android:layout_margin="0.5dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="XIRR" android:textSize="10sp"
                                android:textColor="@color/t800" android:letterSpacing="0.04"
                                android:layout_marginBottom="4dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="19.2% p.a." android:textSize="13sp" android:textColor="@color/positive"
                                android:fontFamily="@font/jetbrains_mono" />
                        </LinearLayout>
            </GridLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:layout_marginBottom="22dp">

            <!-- Section header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical|bottom"
                android:layout_marginBottom="11dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Active SIPs" android:textSize="15.5sp" android:textStyle="bold"
                    android:textColor="@color/t100" android:letterSpacing="-0.01" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New SIP" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/accent" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_rows_wrap"
                android:clipToOutline="true">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="13dp" android:paddingBottom="13dp"
                    android:background="@drawable/bg_row">
                    <TextView android:layout_width="34dp" android:layout_height="34dp"
                        android:gravity="center" android:text="PP"
                        android:textSize="11.5sp" android:textStyle="bold"
                        android:textColor="@color/t400" android:background="@drawable/bg_logo"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Parag Parikh Flexi Cap" android:textSize="13sp" android:textColor="@color/t200"
                                android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="₹10,000 · 5th monthly"
                            android:textColor="@color/white"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="18 done" android:textSize="13sp" android:textColor="@color/t200"
                            android:fontFamily="@font/jetbrains_mono" android:gravity="end" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="+22.4%" android:textSize="10.5sp" android:textColor="@color/positive"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/div06"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="13dp" android:paddingBottom="13dp"
                    android:background="@drawable/bg_row">
                    <TextView android:layout_width="34dp" android:layout_height="34dp"
                        android:gravity="center" android:text="QU"
                        android:textSize="11.5sp" android:textStyle="bold"
                        android:textColor="@color/t400" android:background="@drawable/bg_logo"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Quant Small Cap" android:textSize="13sp" android:textColor="@color/t200"
                                android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹8,000 · 5th monthly" android:textSize="10.5sp" android:textColor="@color/white"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="14 done" android:textSize="13sp" android:textColor="@color/t200"
                            android:fontFamily="@font/jetbrains_mono" android:gravity="end" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="+34.1%" android:textSize="10.5sp" android:textColor="@color/positive"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/div06"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="13dp" android:paddingBottom="13dp"
                    android:background="@drawable/bg_row">
                    <TextView android:layout_width="34dp" android:layout_height="34dp"
                        android:gravity="center" android:text="MI"
                        android:textSize="11.5sp" android:textStyle="bold"
                        android:textColor="@color/t400" android:background="@drawable/bg_logo"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Mirae Large Cap" android:textSize="13sp" android:textColor="@color/t200"
                                android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹6,000 · 10th monthly" android:textSize="10.5sp" android:textColor="@color/white"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="22 done" android:textSize="13sp" android:textColor="@color/t200"
                            android:fontFamily="@font/jetbrains_mono" android:gravity="end" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="+12.1%" android:textSize="10.5sp" android:textColor="@color/positive"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/div06"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="13dp" android:paddingBottom="13dp"
                    android:background="@drawable/bg_row">
                    <TextView android:layout_width="34dp" android:layout_height="34dp"
                        android:gravity="center" android:text="HD"
                        android:textSize="11.5sp" android:textStyle="bold"
                        android:textColor="@color/t400" android:background="@drawable/bg_logo"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="HDFC Balanced Adv." android:textSize="13sp" android:textColor="@color/t200"
                                android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹10,000 · 15th monthly" android:textSize="10.5sp" android:textColor="@color/white"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="9 done" android:textSize="13sp" android:textColor="@color/t200"
                            android:fontFamily="@font/jetbrains_mono" android:gravity="end" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="+9.6%" android:textSize="10.5sp" android:textColor="@color/positive"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <!-- ── Banner ── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:layout_marginBottom="22dp">
            <View android:layout_width="2dp" android:layout_height="match_parent"
                android:minHeight="44dp" android:background="@color/accent" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:padding="12dp" android:paddingStart="14dp"
                android:background="@drawable/bg_summary">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Step-up your SIP by 10%"
                    android:textColor="@color/white"
                    android:textSize="12.5sp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Could add ₹4.2L over 5 years" android:textSize="11sp" android:textColor="@color/white"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Set up" android:textSize="11.5sp" android:textStyle="bold"
                android:textColor="@color/accent"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingTop="12dp" android:paddingBottom="12dp"
                android:background="@drawable/bg_banner" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
