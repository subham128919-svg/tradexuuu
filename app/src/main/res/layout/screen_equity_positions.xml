<?xml version="1.0" encoding="utf-8"?>
<!-- Positions screen — contains tvSummaryValue for day P&L -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Day P&L summary bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_item"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="14dp" android:paddingBottom="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Day P&amp;L"
                android:textSize="13sp" android:textColor="@color/t600"/>

            <!-- tvSummaryValue — today's P&L amount -->
            <TextView
                android:id="@+id/tvSummaryValue"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="+₹0.00"
                android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/positive"
                android:fontFamily="@font/jetbrains_mono"/>
        </LinearLayout>

        <!-- Positions list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPositions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:padding="8dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
