<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- ── Summary block ── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" android:paddingBottom="6dp"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_summary">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Today's MTM" android:textSize="11sp"
                android:textColor="@color/t600" android:letterSpacing="0.03"
                android:layout_marginBottom="5dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical|bottom"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="+₹4,286" android:textSize="26sp" android:textColor="@color/t100"
                    android:fontFamily="@font/jetbrains_mono" android:letterSpacing="-0.02"
                    android:layout_marginEnd="9dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Intraday · 3 open" android:textSize="12sp" android:textColor="@color/positive"
                    android:fontFamily="@font/jetbrains_mono" />
            </LinearLayout>

            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:columnCount="2" android:rowCount="2"
                android:layout_marginBottom="10dp"
                android:background="@color/div06">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:orientation="vertical"
                            android:padding="11dp" android:paddingStart="13dp"
                            android:background="@drawable/bg_stat_cell" android:layout_margin="0.5dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="REALISED" android:textSize="10sp"
                                android:textColor="@color/t800" android:letterSpacing="0.04"
                                android:layout_marginBottom="4dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="+₹1,240" android:textSize="13sp" android:textColor="@color/positive"
                                android:fontFamily="@font/jetbrains_mono" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:orientation="vertical"
                            android:padding="11dp" android:paddingStart="13dp"
                            android:background="@drawable/bg_stat_cell" android:layout_margin="0.5dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="UNREALISED" android:textSize="10sp"
                                android:textColor="@color/t800" android:letterSpacing="0.04"
                                android:layout_marginBottom="4dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="+₹3,046" android:textSize="13sp" android:textColor="@color/positive"
                                android:fontFamily="@font/jetbrains_mono" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:orientation="vertical"
                            android:padding="11dp" android:paddingStart="13dp"
                            android:background="@drawable/bg_stat_cell" android:layout_margin="0.5dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="MARGIN USED" android:textSize="10sp"
                                android:textColor="@color/t800" android:letterSpacing="0.04"
                                android:layout_marginBottom="4dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="₹48,200" android:textSize="13sp" android:textColor="@color/t200"
                                android:fontFamily="@font/jetbrains_mono" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:orientation="vertical"
                            android:padding="11dp" android:paddingStart="13dp"
                            android:background="@drawable/bg_stat_cell" android:layout_margin="0.5dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="AVAILABLE" android:textSize="10sp"
                                android:textColor="@color/t800" android:letterSpacing="0.04"
                                android:layout_marginBottom="4dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="₹1,36,060" android:textSize="13sp" android:textColor="@color/t200"
                                android:fontFamily="@font/jetbrains_mono" />
                        </LinearLayout>
            </GridLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:layout_marginBottom="22dp">

            <!-- Section header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical|bottom"
                android:layout_marginBottom="11dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Open positions" android:textSize="15.5sp" android:textStyle="bold"
                    android:textColor="@color/t100" android:letterSpacing="-0.01" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Exit all" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/accent" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_rows_wrap"
                android:clipToOutline="true">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="13dp" android:paddingBottom="13dp"
                    android:background="@drawable/bg_row">
                    <TextView android:layout_width="34dp" android:layout_height="34dp"
                        android:gravity="center" android:text="TP"
                        android:textSize="11.5sp" android:textStyle="bold"
                        android:textColor="@color/t400" android:background="@drawable/bg_logo"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Tata Power MIS" android:textSize="13sp" android:textColor="@color/t200"
                                android:maxLines="1" android:ellipsize="end" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="BUY" android:textSize="9sp" android:textStyle="bold"
                                android:textColor="@color/tag_buy_text" android:background="@drawable/bg_tag_buy"
                                android:paddingStart="5dp" android:paddingEnd="5dp"
                                android:paddingTop="2.5dp" android:paddingBottom="2.5dp"
                                android:layout_marginStart="7dp" android:letterSpacing="0.06" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="50 qty · avg ₹416.20" android:textSize="10.5sp" android:textColor="@color/t800"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹428.90" android:textSize="13sp" android:textColor="@color/t200"
                            android:fontFamily="@font/jetbrains_mono" android:gravity="end" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="+₹635" android:textSize="10.5sp" android:textColor="@color/positive"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/div06"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="13dp" android:paddingBottom="13dp"
                    android:background="@drawable/bg_row">
                    <TextView android:layout_width="34dp" android:layout_height="34dp"
                        android:gravity="center" android:text="ZO"
                        android:textSize="11.5sp" android:textStyle="bold"
                        android:textColor="@color/t400" android:background="@drawable/bg_logo"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Zomato MIS" android:textSize="13sp" android:textColor="@color/t200"
                                android:maxLines="1" android:ellipsize="end" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="SELL" android:textSize="9sp" android:textStyle="bold"
                                android:textColor="@color/tag_sell_text" android:background="@drawable/bg_tag_sell"
                                android:paddingStart="5dp" android:paddingEnd="5dp"
                                android:paddingTop="2.5dp" android:paddingBottom="2.5dp"
                                android:layout_marginStart="7dp" android:letterSpacing="0.06" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="200 qty · avg ₹272.10" android:textSize="10.5sp" android:textColor="@color/t800"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹268.40" android:textSize="13sp" android:textColor="@color/t200"
                            android:fontFamily="@font/jetbrains_mono" android:gravity="end" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="+₹740" android:textSize="10.5sp" android:textColor="@color/positive"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/div06"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="13dp" android:paddingBottom="13dp"
                    android:background="@drawable/bg_row">
                    <TextView android:layout_width="34dp" android:layout_height="34dp"
                        android:gravity="center" android:text="SB"
                        android:textSize="11.5sp" android:textStyle="bold"
                        android:textColor="@color/t400" android:background="@drawable/bg_logo"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="SBI MIS" android:textSize="13sp" android:textColor="@color/t200"
                                android:maxLines="1" android:ellipsize="end" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="BUY" android:textSize="9sp" android:textStyle="bold"
                                android:textColor="@color/tag_buy_text" android:background="@drawable/bg_tag_buy"
                                android:paddingStart="5dp" android:paddingEnd="5dp"
                                android:paddingTop="2.5dp" android:paddingBottom="2.5dp"
                                android:layout_marginStart="7dp" android:letterSpacing="0.06" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="30 qty · avg ₹818.40" android:textSize="10.5sp" android:textColor="@color/t800"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="₹824.35" android:textSize="13sp" android:textColor="@color/t200"
                            android:fontFamily="@font/jetbrains_mono" android:gravity="end" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="+₹178" android:textSize="10.5sp" android:textColor="@color/positive"
                            android:fontFamily="@font/jetbrains_mono" android:layout_marginTop="3dp" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
